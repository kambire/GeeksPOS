# GeeksPOS - plantilla de variables de entorno.
# Copiar a .env y completar. .env NUNCA va al repositorio.

# Base de datos MariaDB
DB_HOST=db
DB_NAME=geekscom_nicole
DB_USER=geekscom_nicole
DB_PASS=cambiar_por_clave_larga        # openssl rand -hex 16
MYSQL_ROOT_PASSWORD=cambiar_por_clave_larga

# Evolution API (WhatsApp). Si se cambia, actualizar también el header "apikey" de los nodos HTTP del flujo n8n.
EVOLUTION_DB_PASS=cambiar_por_clave_larga
EVOLUTION_API_KEY=cambiar_por_clave_larga   # openssl rand -hex 24

# API pública de n8n (Settings > n8n API en el editor de n8n)
N8N_API_KEY=

# Clave maestra para cifrar las claves de IA de cada local (AES-256-GCM).
# Generar UNA vez: openssl rand -base64 32   (si se pierde, hay que volver a cargar las claves de IA)
GEEKSIA_SECRET_KEY=

# Clave REST de plataforma para n8n / integraciones internas (solo se acepta desde redes privadas)
GEEKSPOS_PLATFORM_API_KEY=
GEEKSPOS_PLATFORM_ALLOW_PUBLIC=0
